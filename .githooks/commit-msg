#!/bin/sh
#
# Не пускать чужую атрибуцию в историю репозитория.
#
# ⚠️ ЗАЧЕМ. Правило владельца: авторство в GitHub — только eva3si0n. Держалось оно
# на памяти, и 29.08.2026 сверка нашла трейлеры `Co-Authored-By` в 63 коммитах
# InfraLab и 15 в монорепо клиентов, включая два коммита того же дня. Историю не
# переписываем (решение 29.07.2026), но новые коммиты обязаны быть чистыми.
#
# Проверка стоит в САМОЙ команде, а не в чьей-то памяти — см. правило «повтор
# ошибки чинит инструмент». Обойти осознанно: git commit --no-verify.

msg="$1"

if grep -qiE '^(Co-Authored-By:.*(Claude|Anthropic)|Claude-Session:)' "$msg"; then
  echo "КОММИТ ОТКЛОНЁН: в сообщении чужая атрибуция." >&2
  grep -inE '^(Co-Authored-By:.*(Claude|Anthropic)|Claude-Session:)' "$msg" | sed 's/^/    /' >&2
  echo "  Авторство в этом репозитории — только eva3si0n." >&2
  echo "  Уберите строку и повторите (осознанно обойти: --no-verify)." >&2
  exit 1
fi

exit 0
