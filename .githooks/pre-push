#!/bin/bash
# pre-push — общая гигиена документации перед отправкой в GitHub.
#
# ⚠️ ЧТО ЭТО. Сторож ОБЩИЙ для всех репозиториев владельца: он живёт в InfraLab
# (`hardware/mac-studio/docs-check/docs-hygiene.py`) и ставится в `~/bin`. Повод заведения —
# замер 13.09.2026 по одиннадцати репозиториям: 171 файл `.md`, 37 ADR, а сторож на пуше
# только у трёх. Восемь не проверялись ничем — этот репозиторий был среди них.
#
# Проверяется то, что НЕ зависит от предмета репозитория:
#
#   живые ссылки          каждая относительная `](путь)` в .md обязана существовать
#   имена файлов из прозы `tools/x.py` в тексте обязано разрешаться — но только если
#                         первый сегмент это настоящий каталог ЭТОГО репозитория
#                         (иначе ругалось бы на файлы соседних репо: замер дал 390 отказов)
#   отметки «сверено»     <!-- сверено: <цель> @ <коммит> --> у разделов про поведение:
#                         код уехал дальше отметки — абзац перечитать
#   статусы ADR           значок в самом ADR против значка в таблице docs/adr/README.md
#
# ⚠️ Отметок «сверено» здесь пока НЕТ НИ ОДНОЙ, и это нормально: проверка молчит, пока их
# не расставят. Заводить их стоит у разделов, описывающих ПОВЕДЕНИЕ, и привязывать к узкому
# коду — замер в TVV: большие файлы правятся 30+ раз в месяц, и привязка к ним краснела бы
# ежедневно, а к отдельной функции — раз.
#
# ⚠️ Если у прозы законно упоминаются файлы соседних репозиториев, чьи имена совпали с
# нашими каталогами, — положить `.docs-hygiene.json` с полем "чужие". Каждая запись в нём
# обязана быть упомянута хоть где-то, иначе список зарастает и сторож об этом скажет.
#
# Установка в клоне (один раз, локальная настройка, при клонировании НЕ передаётся):
#   git config core.hooksPath .githooks
#
# Обойти осознанно: git push --no-verify

HYG="$HOME/bin/docs-hygiene.py"

# Нет на машине — предупреждение, пуш идёт. Блокировать работу из-за ОТСУТСТВИЯ проверки
# значит получить хук, который снимут первым же вечером; тот же довод записан в хуках
# InfraLab и TVV.
if [ ! -x "$HYG" ]; then
  echo "pre-push: общего сторожа гигиены нет ($HYG) — проверка пропущена, пуш продолжается" >&2
  exit 0
fi

if ! "$HYG" --quiet .; then
  echo "" >&2
  echo "ПУШ ОСТАНОВЛЕН: гигиена документации." >&2
  echo "Почините и повторите (осознанно обойти: git push --no-verify)." >&2
  exit 1
fi

echo "pre-push: документация сходится"
exit 0
